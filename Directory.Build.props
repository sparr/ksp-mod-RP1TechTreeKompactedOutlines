<Project>
  <!-- Version.props holds the mod version. It is generated from Version.props.versiontemplate. -->
  <Import Project="$(MSBuildThisFileDirectory)Version.props" />

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

    <!--
      KSPBuildTools imports $(SolutionDir)$(SolutionName).props.user to find the game.
      SolutionDir is unset when a csproj is built directly, so supply it here.
    -->
    <SolutionDir Condition=" '$(SolutionDir)' == '' ">$(RepoRoot)</SolutionDir>
    <SolutionName Condition=" '$(SolutionName)' == '' ">RP1TechTreeKompactedOutlines</SolutionName>

    <!-- The folder that players install into GameData. -->
    <KSPBT_ModRoot>$(RepoRoot)GameData/RP1TechTreeKompactedOutlines/</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>

    <Product>RP1TechTreeKompactedOutlines</Product>
    <Authors>Clarence "Sparr" Risher</Authors>
    <Copyright>Copyright (c) 2026 Clarence "Sparr" Risher</Copyright>
    <Description>Draws colored outlines around each blue sky tech and the techs it unlocks in RP-1 TechTree Kompacted.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sparr/ksp-mod-RP1TechTreeKompactedOutlines</RepositoryUrl>
  </PropertyGroup>
</Project>
